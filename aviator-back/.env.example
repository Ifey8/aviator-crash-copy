# --- Host-side port mapping (only matters when running via docker compose) ---
# Override these if 5000 / 27017 are already in use on your server.
API_PORT=5000
MONGO_PORT=27017

# --- Backend internals ---
PORT=5000
MONGO_URI=mongodb://mongo:27017/aviator
JWT_SECRET=change-me-please
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=http://localhost:3000
ALLOW_DEV_AUTH=true
INITIAL_BALANCE=1000
MIN_BET=1
MAX_BET=1000
BET_DURATION_MS=5000
SETTLE_DURATION_MS=3000
HOUSE_EDGE=0.03
