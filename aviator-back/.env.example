# --- Host-side port mapping (docker compose) ---
# Default scheme: 188xx range to avoid common-port conflicts on the server.
#   18803 = frontend       (mnemonic: 03 → 3000)
#   18805 = backend api    (mnemonic: 05 → 5000)
#   18827 = mongodb        (mnemonic: 27 → 27017)
API_PORT=18805
MONGO_PORT=18827

# --- Backend internals ---
PORT=18805
MONGO_URI=mongodb://mongo:27017/aviator
JWT_SECRET=change-me-please
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=http://localhost:18803
ALLOW_DEV_AUTH=true
INITIAL_BALANCE=1000
MIN_BET=1
MAX_BET=1000
BET_DURATION_MS=5000
SETTLE_DURATION_MS=3000
HOUSE_EDGE=0.03

# --- Crypto (TRON USDT-TRC20) recharge ---
# Network: shasta (testnet) | mainnet | "" (disable feature entirely)
TRON_NETWORK=shasta
# Your TronLink wallet that COLLECTS deposits. Same address can be used
# to deploy MockUSDT.sol on Shasta (deployer gets the entire supply).
TRON_USDT_RECEIVER=
# TRC20 contract address.
#   Shasta:  the address you deploy MockUSDT.sol to (TG... format)
#   Mainnet: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t (real Tether USDT)
TRON_USDT_CONTRACT=
# Optional — get free key at trongrid.io to lift the public rate limits.
TRONGRID_API_KEY=
# Watcher poll interval (default 30s).
CRYPTO_WATCH_INTERVAL_MS=30000
# Confirmation count before crediting. 1 fine for testnet; 19+ on mainnet.
CRYPTO_MIN_CONFIRMATIONS=1
# Order expiry — user must transfer USDT within this window.
CRYPTO_ORDER_TTL_MS=900000
# Min/max USDT per order.
CRYPTO_MIN_USDT=10
CRYPTO_MAX_USDT=5000
# Fallback rate when CoinGecko unreachable. Adjust as needed.
USDT_INR_RATE=83
