# --- Host-side port mapping (docker compose) ---
# Default scheme: 188xx range to avoid common-port conflicts on the server.
#   18803 = frontend       (mnemonic: 03 → 3000)
#   18805 = backend api    (mnemonic: 05 → 5000)
#   18827 = mongodb        (mnemonic: 27 → 27017)
API_PORT=18805
MONGO_PORT=18827

# --- Backend internals ---
PORT=18805
MONGO_URI=mongodb://mongo:27017/aviator
JWT_SECRET=change-me-please
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=http://localhost:18803
ALLOW_DEV_AUTH=true
INITIAL_BALANCE=1000
MIN_BET=1
MAX_BET=1000
BET_DURATION_MS=5000
SETTLE_DURATION_MS=3000
HOUSE_EDGE=0.03
# Hard cap on crash multiplier. 100x ≈ 80s round.
MAX_CRASH_MULTIPLIER=100

# --- Crypto (TRON USDT-TRC20) recharge ---
# Network: shasta (testnet) | mainnet | "" (disable feature entirely)
TRON_NETWORK=shasta
# TRC20 contract address.
#   Shasta:  the address you deploy MockUSDT.sol to (TG... format)
#   Mainnet: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t (real Tether USDT)
TRON_USDT_CONTRACT=
# HD MASTER MNEMONIC — server's wallet seed. Generate ONCE via:
#   docker compose exec api node dist/tools/gen-master-seed.js
# Each order derives a unique deposit address from this seed (BIP44
# m/44'/195'/0'/0/N). Index 0 is the hot wallet (receives sweeps).
# CRITICAL: BACK UP OFF-LINE. If you lose this, you lose every USDT
# collected. Never commit, never share.
CRYPTO_MASTER_MNEMONIC=
# Hot-wallet derivation index (default 0). Only change if you have a
# specific reason — must be < every deposit index ever issued.
CRYPTO_HOT_WALLET_INDEX=0
# When sweeping, top up each deposit address to at least this much TRX
# so the USDT transfer has gas. ~30 TRX = ~3-4 transfers worth.
CRYPTO_SWEEP_GAS_RESERVE_TRX=30
# After an order finalises (paid / expired / cancelled), wait this long
# before recycling its deposit address for a new order. 1h default —
# protects against late payments getting misattributed. Order TTL is
# 15min, so total dead time per address is ~75min.
CRYPTO_ADDRESS_REUSE_COOLDOWN_MS=3600000
# Optional — get free key at trongrid.io to lift the public rate limits.
TRONGRID_API_KEY=
# Watcher poll interval (default 30s).
CRYPTO_WATCH_INTERVAL_MS=30000
# Confirmation count before crediting. 1 fine for testnet; 19+ on mainnet.
CRYPTO_MIN_CONFIRMATIONS=1
# Order expiry — user must transfer USDT within this window.
CRYPTO_ORDER_TTL_MS=900000
# Min/max USDT per order (input validation; users can OVERPAY without limit).
CRYPTO_MIN_USDT=10
CRYPTO_MAX_USDT=5000
# Fallback rate when CoinGecko unreachable. Adjust as needed.
USDT_INR_RATE=83
