# Aviator nginx server block
# setup.sh substitutes __DOMAIN__ + __ROOT__ at install time, then certbot
# adds the SSL listener + redirect block.
#
# After certbot runs, this file ends up roughly as:
#
#   server { listen 443 ssl; ... ssl_certificate ...; }
#   server { listen 80; return 301 https://$host$request_uri; }
#
# If you ever need to re-generate from scratch:
#   sed 's|__DOMAIN__|aviator.example.com|g; s|__ROOT__|/var/www/aviator/build|g' \
#       deploy/nginx.aviator.conf.example > /etc/nginx/sites-available/aviator.example.com

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root __ROOT__;
    index index.html;

    # CRA SPA: any unknown route falls back to index.html so client-side
    # routing (e.g. /admin, /mock-pay) works on direct refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API → backend container.
    location /api/ {
        proxy_pass http://localhost:18805;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Recharge / crypto webhooks may be slow occasionally.
        proxy_read_timeout 30s;
    }

    # Socket.IO (websocket upgrade).
    location /socket.io/ {
        proxy_pass http://localhost:18805;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Long-lived idle for game in BET phase.
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Public health probe.
    location = /health {
        proxy_pass http://localhost:18805/health;
        access_log off;
    }

    # Cache static assets aggressively (CRA hashes filenames).
    location ~* \.(?:js|css|png|jpg|jpeg|svg|webp|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Big enough for Telegram initData payloads.
    client_max_body_size 256k;

    # Hide nginx version.
    server_tokens off;
}
